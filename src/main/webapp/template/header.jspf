<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>PC Configurator</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/template/style.css">
    <script src="${pageContext.request.contextPath}/template/script.js" defer></script>
</head>
<body>

<header>
    <div class="nav-container">
        <a href="${pageContext.request.contextPath}/components" class="logo">PC Configurator</a>
        <nav>
            <a href="${pageContext.request.contextPath}/components">Комплектующие</a>
            <a href="${pageContext.request.contextPath}/builds">Сборки</a>
            <c:if test="${not empty sessionScope.currentUser}">
                <a href="${pageContext.request.contextPath}/logout">Выйти из аккаунта (<c:out value="${sessionScope.currentUser.username}"/>)</a>
            </c:if>
        </nav>
    </div>
</header>

<main class="container">
    <c:if test="${not empty sessionScope.error}">
        <div class="alert alert-danger">
            <c:out value="${sessionScope.error}"/>
            <c:remove var="error" scope="session"/>
        </div>
    </c:if>